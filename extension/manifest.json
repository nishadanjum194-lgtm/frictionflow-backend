{
  "manifest_version": 3,
  "name": "FrictionFlow - Habit Friction & Focus",
  "version": "1.2.0",
  "description": "Adds a mindful pause, optional maths challenge and 15-minute focus pass before distracting websites.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "frictionflow@anjum.addon",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
