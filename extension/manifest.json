{
  "manifest_version": 3,
  "name": "FrictionFlow - Habit Friction & Focus",
  "version": "1.1.0",
  "description": "Adds mindful friction (wait time, math, breathing, focus pass) before distracting websites.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "frictionflow@anjum.addon",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}