# Runtime
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# Database location (defaults to ./frictionflow.db next to server.js)
# DB_PATH=/var/data/frictionflow.db

# CORS origin: comma-separated list or * in development
CORS_ORIGIN=*

# Optional: if set, POST /api/analytics requires X-API-Key header or api_key query param.
# Leave unset for local development only.
API_KEY=