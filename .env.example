# Runtime
PORT=5001
# Use 0.0.0.0 only for a container or hosted deployment.
HOST=0.0.0.0
NODE_ENV=production

# Database location (defaults to ./frictionflow.db next to server.js)
# DB_PATH=/var/data/frictionflow.db

# Restrict CORS to the dashboard and extension origins in production.
CORS_ORIGIN=*

# Required in production for all analytics read/write endpoints.
# Generate a long random value and keep it private.
API_KEY=
