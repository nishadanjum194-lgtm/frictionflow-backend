# Runtime
PORT=5001
# Local default. Set to 0.0.0.0 when running behind a container/platform proxy.
HOST=127.0.0.1
NODE_ENV=development

# Database location (defaults to ./frictionflow.db next to server.js)
# DB_PATH=/var/data/frictionflow.db

# Browser extension origins are allowed by the backend. Add the dashboard origin
# here when it is hosted separately. "*" is accepted only outside production.
CORS_ORIGIN=*

# Required in production; used for analytics writes and reads.
API_KEY=
